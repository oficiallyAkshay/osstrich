{
  "name": "osstrich",
  "version": "0.0.1",
  "description": "Plan-to-PR upstream contribution workflow: discover what to give back, then build it to a merged pull request.",
  "type": "module",
  "bin": {
    "osstrich": "bin/osstrich.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=bin/** --test-coverage-lines=98 --test-coverage-branches=85 --test-coverage-functions=96 --test-reporter=lcov --test-reporter-destination=coverage.lcov --test-reporter=spec --test-reporter-destination=stdout test/**/*.test.mjs",
    "check": "node --test 'test/**/*.test.mjs'",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@dotenvx/dotenvx": "2.24.1",
    "cockatiel": "4.0.0",
    "execa": "10.0.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0"
  }
}
